# Dépendances
node_modules/

# Next.js
.next/
out/
.turbo/
.vercel/

# Build & artefacts
dist/
build/
*.tsbuildinfo
# Généré par Next.js à chaque `next dev` / `next build` — ne doit jamais
# être commité (typo précédente : `.next-env.d.ts` avec point initial).
next-env.d.ts

# Env / secrets — on garde un éventuel .env.example
.env
.env.local
.env*.local
.env.development
.env.production

# Base SQLite locale (régénérable via `prisma db push` + seed)
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Backups SQLite produits par scripts/backup-sqlite.sh
backups/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache & tmp
.cache/
tmp_*
*.tmp

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Outils dev locaux
.claude/

# PWA build local
public/sw.js
public/workbox-*.js
public/worker-*.js
public/swe-worker-*.js

# Données Excel sources (volumineuses, à archiver à part)
data*.xlsx
data*.xlsm
