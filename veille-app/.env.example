DATABASE_URL="file:./dev.db"
# secret pour signer les cookies (changer en prod)
VEILLE_AUTH_SECRET="change-me-32-chars-min-aaaaaaaaaaaa"
# clé pour les Server Actions (openssl rand -base64 32)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Optionnel : dossier de stockage des photos uploadées (par défaut public/uploads)
VEILLE_UPLOAD_DIR=""

# --- Sentry (optionnel) ---
# Laisser vide pour désactiver Sentry. Tant que ces variables sont vides,
# aucun appel réseau Sentry n'est effectué et aucune capture n'est faite.
# Pour activer : créer un projet sur sentry.io et coller les DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"

# --- Logger ---
# Niveau de log minimal. Mettre "debug" pour activer les logs debug.
LOG_LEVEL="info"

# --- Feature flags ---
# Active l'écran d'accueil "Aujourd'hui" (Sprint 2 — US-2.1).
# Activé par défaut. Mettre à "false" pour rollback rapide en production :
# la racine "/" redirige alors vers "/procedures" (comportement legacy).
ENABLE_TODAY="true"

# --- Push notifications (Sprint Push V1) ---
# Master switch pour le canal push. À "false" → l'app continue de fonctionner
# (Notification in-app inchangées), mais aucun POST web-push n'est émis.
# Utile pour rollback rapide en cas d'incident push service.
ENABLE_PUSH="true"

# Clés VAPID — RFC 8292. Générer une fois avec :
#   npx web-push generate-vapid-keys
# Stocker la paire en variables d'environnement. NE JAMAIS commit les clés
# de production. Une rotation invalide TOUS les abonnements existants
# (cf. docs/push-notifications.md §Rotation).
#
# La clé publique est lue côté client → préfixe NEXT_PUBLIC_ obligatoire.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# La clé privée reste serveur uniquement (jamais préfixée NEXT_PUBLIC_).
VAPID_PRIVATE_KEY=""
# Subject VAPID — mailto: requis par FCM. Format strict "mailto:<email>" ou URL.
VAPID_SUBJECT="mailto:contact@example.com"

# Secret partagé pour les routes cron (POST /api/cron/*). Le runner cron
# envoie ce token dans le header `x-cron-secret`. Générer 32+ chars random :
#   openssl rand -hex 32
CRON_SECRET=""
